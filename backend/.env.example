# Local dev defaults to SQLite. For Postgres/Neon set the full connection string, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./cursor_northampton.db

JWT_SECRET=please-change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

ADMIN_EMAIL=admin@cursornorthampton.dev
ADMIN_PASSWORD=admin1234

# Comma-separated list of allowed frontend origins for CORS
FRONTEND_ORIGIN=http://localhost:5173
